.root {
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
}

.scroll-view {
    width: 100%;
    height: 100%;
    padding: 20px;
}

.player-info-section {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
    padding: 20px;
    background-color: #2a2a2a;
    border-radius: 15px;
}

.player-avatar {
    width: 100px;
    height: 100px;
    background-color: #3a3a3a;
    border-radius: 50px;
    margin-right: 20px;
}

.player-name {
    font-size: 32px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-right: 30px;
}

.elo-container {
    flex-direction: column;
    margin-left: auto;
}

.current-elo {
    font-size: 42px;
    -unity-font-style: bold;
    color: #4CAF50;
}

.elo-label {
    font-size: 16px;
    color: #9E9E9E;
}

.section-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: #3a3a3a;
}

.stats-section, .detailed-stats-section, .graph-section {
    margin-bottom: 30px;
    padding: 20px;
    background-color: #2a2a2a;
    border-radius: 15px;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-item {
    width: 48%;
    margin-bottom: 15px;
    padding: 15px;
    background-color: #3a3a3a;
    border-radius: 10px;
}

.stat-value {
    font-size: 28px;
    -unity-font-style: bold;
    color: #ffffff;
}

.stat-label {
    font-size: 16px;
    color: #9E9E9E;
}

.graph-container {
    height: 300px;
    background-color: #3a3a3a;
    border-radius: 10px;
    padding: 15px;
    position: relative;
}

.graph-area {
    width: 100%;
    height: 100%;
}

.graph-labels {
    position: absolute;
    width: 100%;
    height: 100%;
}

.y-axis-label {
    position: absolute;
    left: 0;
    color: #9E9E9E;
    font-size: 14px;
}

.y-axis-label.min {
    bottom: 0;
}

.y-axis-label.max {
    top: 0;
}

.x-axis-label {
    position: absolute;
    bottom: -20px;
    color: #9E9E9E;
    font-size: 14px;
}

.x-axis-label.start {
    left: 0;
}

.x-axis-label.end {
    right: 0;
}

.close-btn {
    position: relative;
    width: 120px;
    height: 100px;
    border-radius: 12px;  /* М'яке закруглення кутів */
    background-color: rgba(255, 70, 70, 0.9);

    -unity-font-style: bold;
    font-size: 38px;
    color: white;
    -unity-text-align: middle-center;

    border-width: 0;

    transition: all 0.2s ease;
}

.close-btn:hover {
    background-color: rgba(255, 50, 50, 1);
    transform: scale(1.08);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.close-btn:active {
    background-color: rgba(255, 30, 30, 1);
    transform: scale(0.95);
}

.close-btn:focus {
    outline: 2px solid rgba(255, 255, 255, 0.5);
}