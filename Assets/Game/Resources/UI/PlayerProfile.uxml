<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/Resources/UI/PlayerStatsPanel.uss" />
    <engine:VisualElement class="root">
        <engine:ScrollView show-horizontal-scroller="false" class="scroll-view">
            <engine:VisualElement class="player-info-section">
                <engine:VisualElement class="player-avatar" />
                <engine:Label name="player-name" text="Гравець" class="player-name" />
                <engine:VisualElement class="elo-container">
                    <engine:Label name="current-elo" text="1500" class="current-elo" />
                    <engine:Label text="Поточний рейтинг" class="elo-label" />
                </engine:VisualElement>
                <engine:Button name="close-button" class="close-btn" text="✕" />
            </engine:VisualElement>
            
            <engine:VisualElement class="stats-section">
                <engine:Label text="Загальна статистика" class="section-title" />
                <engine:VisualElement class="stats-grid">
                    <engine:VisualElement class="stat-item">
                        <engine:Label name="matches" text="50" class="stat-value" />
                        <engine:Label text="Матчів" class="stat-label" />
                    </engine:VisualElement>
                    <engine:VisualElement class="stat-item">
                        <engine:Label name="wins" text="32" class="stat-value" />
                        <engine:Label text="Перемог" class="stat-label" />
                    </engine:VisualElement>
                    <engine:VisualElement class="stat-item">
                        <engine:Label name="losses" text="15" class="stat-value" />
                        <engine:Label text="Поразок" class="stat-label" />
                    </engine:VisualElement>
                    <engine:VisualElement class="stat-item">
                        <engine:Label name="win-rate" text="65.5%" class="stat-value" />
                        <engine:Label text="% Перемог" class="stat-label" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
            
            <engine:VisualElement class="graph-section">
                <engine:Label text="Прогрес рейтингу" class="section-title" />
                <engine:VisualElement class="graph-container">
                    <engine:VisualElement name="graph-lines" class="graph-area" />
                    <engine:VisualElement name="graph-dots" class="graph-points" />
                    <engine:VisualElement class="graph-labels">
                        <engine:Label name="min" text="1000" class="y-axis-label min" />
                        <engine:Label name="max" text="2000" class="y-axis-label max" />
                        <engine:Label text="Січ" class="x-axis-label start" />
                        <engine:Label text="Гру" class="x-axis-label end" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:ScrollView>
    </engine:VisualElement>
</engine:UXML>